# Единые настройки локального стенда.
# Скопируйте в .env и при необходимости измените значения.
# .env исключён из Git; значения ниже — только для локальной лаборатории.

COMPOSE_PROJECT_NAME=conan2-ci-lab
TZ=UTC

# Пароль администратора Artifactory (Compose и bootstrap используют его).
ARTIFACTORY_PASSWORD=password

# Пароли, которые bootstrap создаёт в Gitea и Jenkins.
GITEA_ADMIN_PASSWORD=password
JENKINS_ADMIN_PASSWORD=password
