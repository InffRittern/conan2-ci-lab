pipeline {
    agent any

    environment {
        PATH            = "/opt/conan-venv/bin:${env.PATH}"
        CONAN_USERNAME  = "admin"
        ARTIFACTORY_URL = "http://artifactory:8082"
        PACKAGES_REMOTE = "packages"
        PRODUCTS_REMOTE = "products"
        DEVELOP_REMOTE  = "develop"
        CC              = "gcc-13"
        CXX             = "g++-13"
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                sh 'git rev-parse HEAD'
            }
        }

        stage('Configure Conan remotes') {
            steps {
                withCredentials([string(credentialsId: 'artifactory-password', variable: 'CONAN_PASSWORD')]) {
                    sh 'bash scripts/bootstrap-remotes.sh'
                }
            }
        }

        stage('Build and publish libraries') {
            steps {
                withCredentials([string(credentialsId: 'artifactory-password', variable: 'CONAN_PASSWORD')]) {
                    sh '''
                        set -euo pipefail
                        bash scripts/packages-pipeline.sh libs/ap-base 1.0.0
                        bash scripts/packages-pipeline.sh libs/ap-headers 1.3.290
                        bash scripts/packages-pipeline.sh libs/ap-headers 1.4.1
                        bash scripts/packages-pipeline.sh libs/ap-utils 1.0.0
                        bash scripts/packages-pipeline.sh libs/ap-gfx 1.0.0
                        bash scripts/packages-pipeline.sh libs/ap-texture 1.0.0
                        bash scripts/packages-pipeline.sh libs/ap-box 1.0.0
                        bash scripts/packages-pipeline.sh libs/ap-sdk 1.0.0
                    '''
                }
            }
        }

        stage('Build and promote products') {
            steps {
                withCredentials([string(credentialsId: 'artifactory-password', variable: 'CONAN_PASSWORD')]) {
                    sh '''
                        set -euo pipefail
                        bash scripts/products-pipeline.sh products/ap-product-a
                        bash scripts/products-pipeline.sh products/ap-product-b
                    '''
                }
            }
        }

        stage('Verify published packages') {
            steps {
                withCredentials([string(credentialsId: 'artifactory-password', variable: 'CONAN_PASSWORD')]) {
                    sh '''
                        set -euo pipefail
                        for ref in \
                            ap-base/1.0.0 ap-utils/1.0.0 ap-gfx/1.0.0 \
                            ap-headers/1.3.290 ap-headers/1.4.1 \
                            ap-texture/1.0.0 ap-box/1.0.0 \
                            ap-sdk/1.0.0
                        do
                            conan list "${ref}:*" -r "$PACKAGES_REMOTE"
                        done
                        conan list 'ap-product-a/1.0.0:*' -r "$DEVELOP_REMOTE"
                        conan list 'ap-product-b/1.0.0:*' -r "$DEVELOP_REMOTE"
                    '''
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'lockfiles/**/*.lock,lockfiles/**/*packagelist.json', fingerprint: true, allowEmptyArchive: true
        }
    }
}
